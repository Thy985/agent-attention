{
  "id": "claude-code",
  "name": "Claude Code",
  "description": "Anthropic's agentic coding CLI with comprehensive hook system",
  "binaryPatterns": [
    "claude",
    "claude.exe"
  ],
  "installPaths": [
    "~/.claude",
    "%APPDATA%\\Claude"
  ],
  "level": 3,
  "mechanism": "hook",
  "interfaces": {
    "hook": [
      "Notification",
      "Elicitation",
      "StopFailure",
      "SessionStart",
      "Stop"
    ],
    "env": [
      "AGENT_ID",
      "AGENT_NAME",
      "ANTHROPIC_API_KEY"
    ],
    "skill": [
      "~/.claude/skills",
      ".claude/skills"
    ]
  },
  "events": {
    "permission_required": "verified",
    "input_required": "verified",
    "failed": "verified"
  },
  "installInstructions": "Run: agent-attention setup hook --project <directory>. Native settings.json; Stop does not imply task completion. See docs/EVENT-CONTRACT.md.",
  "configFile": "~/.claude/settings.json",
  "skillsPath": "~/.claude/skills",
  "injectAgentId": true,
  "tags": [
    "anthropic",
    "hook",
    "cli",
    "terminal"
  ],
  "docs": [
    "https://code.claude.com/docs/en/hooks.md",
    "https://code.claude.com/docs/en/skills.md"
  ],
  "status": "experimental",
  "evidenceContract": "claude-agent-sdk@0.3.306/hooks-v1"
}
