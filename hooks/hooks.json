{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ANTHROPIC_CLI_AGENT_ATTENTION_HOOK_PATH}\"",
            "statusMessage": "Agent Attention — recording session end",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ANTHROPIC_CLI_AGENT_ATTENTION_HOOK_PATH}\" --session-start",
            "statusMessage": "Agent Attention — session started",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
