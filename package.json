{
  "name": "agent-attention",
  "version": "0.2.0",
  "description": "Agent Attention Center v0.2 — TeamMind Runtime human attention projection layer",
  "type": "commonjs",
  "bin": {
    "agent-notify": "./dist/index.js",
    "agent-attention": "./dist/daemon-cli.js",
    "agent-attention-mcp": "./dist/mcp-server.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:ui": "mise exec -- dotnet build src/center/csharp/AgentAttention.UI/AgentAttention.UI.csproj -c Release",
    "publish:ui": "mise exec -- dotnet publish src/center/csharp/AgentAttention.UI/AgentAttention.UI.csproj -c Release -r win-x64 --self-contained false -o src/center/csharp/dist/win-x64",
    "test": "jest --forceExit",
    "prepare": "npm run build",
    "bin:install": "npm run build && node dist/scripts/install-daemon.js",
    "bin:uninstall": "npm run build && node dist/scripts/uninstall-daemon.js",
    "start:daemon": "node dist/daemon.js",
    "test:ui:harness": "dotnet run --project src/center/csharp/AgentAttention.UI.Harness/AgentAttention.UI.Harness.csproj -c Release --no-build",
    "verify:m1": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/verify-csharp-ui-m1.ps1",
    "bin:agent": "node dist/daemon-cli.js",
    "build:portable": "node scripts/build-portable.mjs"
  },
  "keywords": [
    "agent",
    "notification",
    "cli",
    "toast",
    "attention"
  ],
  "files": [
    "dist/",
    "src/center/csharp/dist/win-x64/**/*",
    "skills/"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^3.6.0",
    "js-yaml": "^4.1.0",
    "node-notifier": "^10.0.1",
    "play-sound": "^1.1.2",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/yargs": "^17.0.33",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0"
  }
}
