<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>AgentAttention.UI</AssemblyName>
    <RootNamespace>AgentAttention.UI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A3 D7: per-monitor DPI awareness so tray icon and Center window render sharply at 125%/150%/200% -->
    <HighDpi>Enable</HighDpi>
    <HighDpiMode>PerMonitorV2</HighDpiMode>
    <EnableWindowsHighDpiAwareness>true</EnableWindowsHighDpiAwareness>
  </PropertyGroup>

</Project>
